# AvailSmart Environment Configuration Example
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,availsmart.in,www.availsmart.in

# MySQL Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=availsmart_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

